# PMAT ignore patterns
# Excludes non-source files from quality analysis

# Generated files
book/
book/**
pkg/
target/
dist/

# Development/debug scripts (not production code)
examples/
tools/
demos/tests/
scripts/

# Benchmark files
**/benchmark.rs
**/bench/

# wasm-bindgen generated snippets
**/snippets/

# JavaScript files (generated)
**/*.js
**/*.min.js

# Python virtual environment
scripts/venv/
.venv/
venv/

# Node modules
node_modules/

# Test fixtures and data files
tests/fixtures/
*.safetensors
*.bin
*.gguf

# Generated code
*_data.rs

# IDE and editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
